server {
    server_name insteip.com www.insteip.com;

    client_max_body_size 110M;

    root /var/www/insteip;
    index index.html;

    # Exclude index.html (and any other SPA route falling back to it) from caching
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0";
        expires off;
    }

    # Cache static hashed JS and CSS files for 1 year
    location ~* \.(?:css|js)$ {
        expires 1y;
        access_log off;
        add_header Cache-Control "public, immutable";
    }

    # Cache static images, icons, and fonts for 1 year
    location ~* \.(?:jpg|jpeg|gif|png|ico|svg|webp|avif|woff|woff2|ttf|otf)$ {
        expires 1y;
        access_log off;
        add_header Cache-Control "public, immutable";
    }

    location /api/ {
        proxy_pass http://127.0.0.1:8081/api/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/insteip.com/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/insteip.com/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot
}

server {
    if ($host = www.insteip.com) {
        return 301 https://$host$request_uri;
    } # managed by Certbot

    if ($host = insteip.com) {
        return 301 https://$host$request_uri;
    } # managed by Certbot

    listen 80;
    server_name insteip.com www.insteip.com;
    return 404; # managed by Certbot
}
